# Database (local dev — matches docker-compose.yml)
DATABASE_URL="postgresql://noteflow:noteflow@localhost:5432/noteflow?schema=public"
DIRECT_URL="postgresql://noteflow:noteflow@localhost:5432/noteflow?schema=public"

# For Neon production, use:
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Server
PORT=3001

# CORS — comma-separated list of allowed origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:5173

# Frontend (in client/.env.local or Vercel env vars)
VITE_API_URL=http://localhost:3001
